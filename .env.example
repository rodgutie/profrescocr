# ─────────────────────────────────────────────────────────────
# ProFresco – variables de entorno
# Copie este archivo a .env.local (en su compu) o péguelas en
# Vercel → Project → Settings → Environment Variables.
# Si NO configura Supabase, el sitio corre en MODO DEMO
# (los datos se guardan solo en el navegador de quien lo prueba).
# ─────────────────────────────────────────────────────────────

# Supabase (login por correo + base de datos de clientes y pedidos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets publicado como CSV (Archivo → Compartir → Publicar en la web → CSV)
# Una URL por pestaña.
SHEET_PRODUCTOS_CSV_URL=
SHEET_PROMOTORES_CSV_URL=

# (Opcional) Apps Script que copia cada pedido nuevo a una hoja "Pedidos"
PEDIDOS_WEBHOOK_URL=
PEDIDOS_WEBHOOK_SECRET=

# Correos con acceso al panel de administración en MODO DEMO (separados por coma).
# En modo real, los administradores se definen en la tabla "admins" de Supabase.
NEXT_PUBLIC_DEMO_ADMIN_EMAILS=admin@profresco.cr

# WhatsApp de ProFresco (solo números, con código de país)
NEXT_PUBLIC_WHATSAPP=50688288013
